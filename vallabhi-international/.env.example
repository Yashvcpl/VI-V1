# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.vallabhiinternational.com

# --- Database (Neon Postgres) - holds ALL content now (pages, services,
# blog posts, leads, admin users, everything) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Admin auth (NextAuth) ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- File uploads (Vercel Blob) - used by every image/file field in the admin ---
BLOB_READ_WRITE_TOKEN=

# --- Email notifications on new leads (Resend) ---
RESEND_API_KEY=
LEAD_NOTIFICATION_TO_EMAIL=leads@vallabhicapital.com
LEAD_NOTIFICATION_FROM_EMAIL=noreply@vallabhiinternational.com

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: Google Search Console verification ---
GOOGLE_SITE_VERIFICATION=
